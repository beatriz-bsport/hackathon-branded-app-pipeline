{
  "compilerOptions": {
    /* 🧱 Basic Language Options */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "outDir": "${configDir}/build",

    /* 🧳 Module Resolution */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* 🧼 Linting / Code Quality */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    /* 🧩 Project Setup */
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* 🎯 Path Aliases */
    "paths": {
      "#src/*": ["${configDir}/src/*"]
    }
  },
  "include": ["${configDir}/src", "${configDir}/src/**/*.json"],
  "exclude": ["${configDir}/**/*.stories.{ts,js,tsx,jsx}"]
}
