{
  "name": "@bsport/analytics",
  "version": "1.0.0",
  "private": false,
  "description": "To collect highly targeted, structured data on how users interact with our platform",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bsport/ichizen/-/tree/dev/packages/utils/analytics"
  },
  "license": "UNLICENSED",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "directories": {
    "build": "build"
  },
  "files": [
    "build",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build",
    "ci:compile": "tsc",
    "ci:publish": "./scripts/ci-publish.sh",
    "dev": "vite build --watch",
    "docs:generate": "tsx ./scripts/generate-events-docs.ts",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "upgrade-version": "npm version"
  },
  "dependencies": {
    "@bsport/broadcast-channel-polyfill": "workspace:*",
    "mixpanel-browser": "^2.60.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*",
    "@bsport/typescript-monorepo-utils": "workspace:*",
    "@types/mixpanel-browser": "^2.60.0",
    "msw": "^2.7.6",
    "tsx": "^4.19.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "peerDependencies": {
    "zod": "^3.25.64"
  },
  "nx": {
    "tags": [
      "postinstall",
      "execute:unit-tests"
    ]
  }
}
