{
  "$schema": "https://json-schema.org/schema",
  "id": "VanillaizeBuilders",
  "title": "Move app-preference options out of a resource's option builders",
  "type": "object",
  "properties": {
    "appName": {
      "type": "string",
      "description": "API package (e.g., cdp, api-cdp or @bsport/api-cdp)",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Which API package?"
    },
    "resource": {
      "type": "string",
      "description": "Resource whose builders to vanillaize (e.g., member)",
      "x-prompt": "Which resource?"
    }
  },
  "required": ["appName", "resource"]
}
