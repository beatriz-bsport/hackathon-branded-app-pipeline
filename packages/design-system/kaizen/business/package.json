{
  "name": "@bsport/kaizen-business-components",
  "version": "0.0.0",
  "private": true,
  "description": "Library of components abstracting business logic",
  "license": "UNLICENSED",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./tailwind-content": {
      "import": "./tailwind-content.mjs",
      "default": "./tailwind-content.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build --logLevel warn",
    "ci:compile": "tsc --noEmit",
    "component:add": "pnpm exec hygen component new",
    "dev": "STORYBOOK_ENV=local STORYBOOK_COMMIT_SHORT_SHA=$(git rev-parse --short=8 HEAD) pnpm run storybook:dev",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pre-commit": "sh ./scripts/pre-commit.sh",
    "storybook:build": "pnpm exec storybook build",
    "storybook:dev": "pnpm exec storybook dev",
    "translation:update": "pnpm run -w translation:update"
  },
  "dependencies": {
    "@bsport/api-buyables": "workspace:*",
    "@bsport/api-cdp": "workspace:*",
    "@bsport/api-core": "workspace:*",
    "@bsport/api-financial-services": "workspace:*",
    "@bsport/currency": "workspace:*",
    "@bsport/datetime-manipulation": "workspace:*",
    "@bsport/store-base": "workspace:*",
    "@bsport/store-buyables-appointment-pass": "workspace:*",
    "@bsport/store-buyables-giftcard": "workspace:*",
    "@bsport/store-buyables-pack": "workspace:*",
    "@bsport/store-buyables-pass": "workspace:*",
    "@bsport/store-buyables-webshop": "workspace:*",
    "@bsport/store-core-data-member": "workspace:*",
    "@bsport/timezone-utils": "workspace:*",
    "@bsport/use-async": "workspace:*",
    "@bsport/use-debounce": "workspace:*",
    "clsx": "^2.1.1",
    "tiny-invariant": "^1.3.3",
    "typescript-result": "^3.1.1"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/kaizen-tokens": "workspace:*",
    "@bsport/local-storage-auth-token": "workspace:*",
    "@nx/vite": "21.6.10",
    "@storybook/addon-docs": "10.1.11",
    "@storybook/addon-themes": "10.1.11",
    "@storybook/react-vite": "10.1.11",
    "@tanstack/react-query": "^5.90.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "glob": "^11.1.0",
    "postcss": "^8.4.49",
    "storybook": "10.1.11",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.1",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.3.0"
  },
  "peerDependencies": {
    "@bsport/fetch": "workspace:*",
    "@bsport/form": "workspace:*",
    "@bsport/i18n": "workspace:*",
    "@bsport/kaizen-primitive-core": "workspace:*",
    "@tanstack/react-query": "^5.90.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.64"
  },
  "nx": {
    "tags": [
      "postinstall"
    ]
  }
}
