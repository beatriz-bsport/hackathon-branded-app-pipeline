{
  "name": "@bsport/store-base",
  "description": "Base store package",
  "version": "0.0.0",
  "author": "Pierre Bondoerffer <pierre.bondoerffer@bsport.io>",
  "dependencies": {
    "@bsport/fetch": "workspace:*",
    "typescript-result": "^3.1.1",
    "use-sync-external-store": "^1.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "files": [
    "build"
  ],
  "license": "UNLICENSED",
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  },
  "type": "module",
  "types": "build/lib.d.ts"
}
