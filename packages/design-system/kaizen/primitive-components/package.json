{
  "name": "@bsport/kaizen-primitive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*",
    "@bsport/kaizen-tokens": "workspace:*",
    "@storybook/addon-themes": "^8.3.5",
    "@types/inquirer": "^9.0.7",
    "@types/lodash": "^4.17.10",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "inquirer": "^8.2.4",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.7",
    "tslib": "^2.6.3",
    "tsx": "^4.17.0",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.0.3",
    "vite-plugin-svgr": "^4.2.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "component:add": "pnpm exec hygen component new",
    "ci:deploy:production": "./scripts/ci-deploy-production.sh",
    "dev": "pnpm run storybook:dev",
    "icon:generate": "tsx ./scripts/generate-icons.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pre-commit": "sh ./scripts/pre-commit.sh",
    "storybook:build": "sb build",
    "storybook:dev": "sb dev"
  }
}
