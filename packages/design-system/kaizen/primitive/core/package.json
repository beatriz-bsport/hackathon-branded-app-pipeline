{
  "name": "@bsport/kaizen-primitive-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./styles": {
      "default": "./dist/style.css"
    }
  },
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build --logLevel warn",
    "ci:compile": "tsc --noEmit",
    "component:add": "pnpm exec hygen component new",
    "dev": "STORYBOOK_ENV=local STORYBOOK_COMMIT_SHORT_SHA=$(git rev-parse --short=8 HEAD) pnpm run storybook:dev",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "icon:generate": "tsx ./scripts/generate-icons.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pre-commit": "sh ./scripts/pre-commit.sh",
    "storybook:build": "sb build",
    "storybook:dev": "sb dev",
    "translation:update": "pnpm run -w translation:update"
  },
  "dependencies": {
    "@bsport/currency": "workspace:*",
    "@bsport/datetime-formatting": "workspace:*",
    "@bsport/datetime-manipulation": "workspace:*",
    "@bsport/i18n": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^11.0.4"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/kaizen-tokens": "workspace:*",
    "@types/inquirer": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.5.1",
    "concurrently": "^8.2.2",
    "inquirer": "^8.2.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-svgr": "^4.3.0"
  },
  "nx": {
    "tags": [
      "postinstall"
    ]
  }
}
