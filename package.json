  "scripts": {
    "analyze": "source-map-explorer build/static/js/main.*",
    "format": "find src -name \"*.js\" | xargs yarn prettier --write",
    "start": "./config-env.sh && yarn updateTranslation && node scripts/start.js",
    "build": "node --max_old_space_size=8192 scripts/build.js",
    "server:build": "webpack -p --progress",
    "test": "node scripts/test.js --env=jsdom",
    "lint": "eslint src",
    "storybook": "./config-env.sh && yarn run start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "updateTranslation": "./scripts/sync-translations.sh"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,mjs}"
    ],
    "setupFiles": [
      "<rootDir>/config/polyfills.js",
      "<rootDir>/dev/setupTests.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,mjs}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx,mjs}"
    ],
    "testEnvironment": "node",
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx|mjs)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "json",
      "web.jsx",
      "jsx",
      "node",
      "mjs"
    ]
  },
  "browserslist": "> 0.25%",
  "eslintConfig": {
    "extends": "react-app"
  },
