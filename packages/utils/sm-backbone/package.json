{
  "name": "@bsport/sm-backbone",
  "version": "0.0.0",
  "private": true,
  "description": "Abstract some logic for Studio Manager applications : Routing, Authentication, Providers...",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    },
    "./tailwind-content": {
      "import": "./tailwind-content.mjs",
      "default": "./tailwind-content.mjs"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "scripts": {
    "build": "tsc && vite build",
    "ci:compile": "tsc",
    "dev": "vite",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bsport/broadcast-channel-polyfill": "workspace:*",
    "@bsport/currency": "workspace:*",
    "@bsport/envs": "workspace:*",
    "@bsport/fetch": "workspace:*",
    "@bsport/i18n": "workspace:*",
    "@bsport/kaizen-primitive-core": "workspace:*",
    "@bsport/local-storage-auth-token": "workspace:*",
    "@bsport/sentry": "workspace:*",
    "@bsport/store-auth": "workspace:*",
    "@bsport/store-base": "workspace:*",
    "@bsport/store-core-data-company": "workspace:*",
    "@bsport/store-core-data-company-theme": "workspace:*",
    "@bsport/store-staff-management-role": "workspace:*",
    "@bsport/timezone-utils": "workspace:*",
    "@unleash/proxy-client-react": "^5.0.1"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*"
  },
  "peerDependencies": {
    "react-router": "^7.2.0"
  },
  "nx": {
    "tags": [
      "postinstall",
      "execute:unit-tests"
    ]
  }
}
