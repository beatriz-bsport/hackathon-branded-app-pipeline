{
  "name": "@bsport/use-pagination-query-params",
  "version": "0.0.0",
  "private": true,
  "description": "Hook to manage pagination state in URL",
  "license": "UNLICENSED",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./build/lib.es.js",
      "require": "./build/lib.umd.js"
    }
  },
  "main": "build/lib.umd.cjs",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "postinstall": "pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@bsport/base-query-params": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*"
  }
}
