{
  "name": "@bsport/api-cdp",
  "version": "0.0.0",
  "private": true,
  "description": "API endpoints and types for the cdp API",
  "license": "UNLICENSED",
  "author": "Charles Castelain <charles.castelain@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./inbox/mocks": {
      "types": "./build/inbox/mocks/index.d.ts",
      "import": "./build/inbox/mocks.js",
      "default": "./build/inbox/mocks.js"
    },
    "./*": {
      "types": "./build/*/index.d.ts",
      "import": "./build/*.js",
      "default": "./build/*.js"
    }
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "ci:compile": "tsc -p tsconfig.json --noEmit",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bsport/store-base": "workspace:*"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*",
    "@bsport/fetch": "workspace:*",
    "@tanstack/react-query": "^5.90.12",
    "@testing-library/react": "^16.3.0",
    "msw": "^2.7.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.12"
  },
  "nx": {
    "tags": [
      "execute:unit-tests",
      "postinstall"
    ]
  }
}
