{
  "compilerOptions": {
    "allowJs": false,
    "outDir": "build",
    "sourceRoot": "src",
    "noEmit": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "baseUrl": ".",
    "lib": [
      "es2015",
      "es2016",
      "es2018",
      "es2017",
      "dom",
      "es2019",
      "es2020",
      "ESNext"
    ],
    "types": ["react"]
  },
  "include": ["./src/**/*.ts*"],
  "exclude": ["**/node_modules/"]
}
