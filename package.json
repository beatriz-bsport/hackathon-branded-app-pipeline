  "scripts": {
    "analyze": "source-map-explorer build/static/js/main.*",
    "format": "find src -name \"*.js\" | xargs yarn prettier --write",
    "start": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && yarn updateTranslation && cp envs/local public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "start-staging": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && yarn updateTranslation && cp envs/staging-api-only public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "build": "export CI=false ; node --max_old_space_size=19000 scripts/build.js",
    "server:build": "webpack -p --progress",
    "test": "export NODE_OPTIONS=--openssl-legacy-provider && yarn jest --logHeapUsage",
    "compile": "npx tsc -p .",
    "lint": "eslint ./src --max-warnings=241",
    "lint-fix": "eslint ./src --fix",
    "lint-cache": "eslint ./src --cache",
    "pretty": "export NODE_OPTIONS=--openssl-legacy-provider && yarn prettier './src' --write --loglevel error",
    "pretty-cache": "export NODE_OPTIONS=--openssl-legacy-provider && yarn prettier './src' --check --cache",
    "pretty-fix": "export NODE_OPTIONS=--openssl-legacy-provider && yarn prettier './src' --write",
    "pretty-fix-cache": "export NODE_OPTIONS=--openssl-legacy-provider && yarn prettier './src' --write --cache",
    "updateTranslation": "./scripts/sync-translations.sh",
    "generate-all-css-marketplace": "cat  **/Marketplace*.css > ./Marketplace.css",
    "prepare": "husky install",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "test-storybook": "test-storybook",
    "refresh-timezone-by-country": "ts-node src/utils/timezone-country/scripts/refresh-timezone-db.ts"
  },
  "browserslist": "> 0.25%",
  "eslintConfig": {
    "extends": "react-app"
