{
  "name": "@bsport/sentry",
  "version": "0.1.0",
  "private": true,
  "description": "Library to init and configure Sentry",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "build:sentry": "VITE_SENTRY_SEND_ERRORS_IN_LOCAL_DEVELOPMENT=true pnpm run build",
    "clean": "rm -rf build",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@bsport/envs": "workspace:*",
    "@bsport/random-utils": "workspace:*",
    "@sentry/react": "^7.26.0"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "nx": {
    "tags": [
      "postinstall"
    ]
  }
}
