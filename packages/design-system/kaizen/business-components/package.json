{
  "name": "@bsport/kaizen-business-components-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Storybook for all Kaizen business components",
  "license": "UNLICENSED",
  "author": "bsport frontend team",
  "type": "module",
  "scripts": {
    "build": "echo 'No build needed for Storybook root'",
    "dev": "STORYBOOK_ENV=local STORYBOOK_COMMIT_SHORT_SHA=$(git rev-parse --short=8 HEAD) pnpm run storybook:dev",
    "storybook:build": "sb build",
    "storybook:dev": "sb dev"
  },
  "devDependencies": {
    "@bsport/fetch": "workspace:*",
    "@bsport/kaizen-tokens": "workspace:*",
    "@bsport/local-storage-auth-token": "workspace:*",
    "@chromatic-com/storybook": "^3.2.2",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-themes": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^4.3.0"
  }
}
