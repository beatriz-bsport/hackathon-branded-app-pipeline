{
  "name": "@bsport/fetch",
  "version": "0.0.0",
  "private": true,
  "description": "bsport API fetch",
  "license": "UNLICENSED",
  "author": "Marwan El Boussarghini <marwan@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "ci:compile": "tsc",
    "clean": "rm -rf build",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bsport/http-exception": "workspace:*",
    "@bsport/local-storage-auth-token": "workspace:*",
    "@bsport/sentry": "workspace:*",
    "@bsport/timezone-utils": "workspace:*"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*",
    "msw": "^2.7.6"
  },
  "nx": {
    "tags": [
      "execute:unit-tests",
      "postinstall"
    ]
  }
}
