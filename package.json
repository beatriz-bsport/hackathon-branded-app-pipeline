{
  "name": "bsport-widget",
  "version": "0.1.0",
  "description": "Bsport widget",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "NODE_ENV=production NODE_OPTIONS='--max_old_space_size=4096' webpack-cli --mode production",
    "start": "NODE_ENV=development webpack-dev-server",
    "analyze": "source-map-explorer dist/widget.js",
    "test": "jest",
    "test-update-snapshots": "jest --updateSnapshot",
    "deploy": "npm run build && gh-pages -d dist",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook -c .storybook -o dist/storybook",
    "lint": "eslint --ext .js --ext .jsx --ext .ts --ext .tsx ./src"
  },
  "babel": {
    "presets": [
      "react-app"
    ],
    "plugins": [
      "@babel/plugin-syntax-dynamic-import",
      "@babel/plugin-syntax-import-meta",
      "@babel/plugin-proposal-class-properties",
      "@babel/plugin-proposal-json-strings",
      [
        "@babel/plugin-proposal-decorators",
        {
          "legacy": true
        }
      ],
      "@babel/plugin-proposal-function-sent",
      "@babel/plugin-proposal-export-namespace-from",
      "@babel/plugin-proposal-numeric-separator",
      "@babel/plugin-proposal-throw-expressions"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.js?(x)"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test-helpers/"
    ],
    "transform": {
      "^.+\\.(js|jsx|mjs)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.(css|scss)$": "<rootDir>/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|css|json)$)": "<rootDir>/jest/fileTransform.js"
    },
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  },
  "serve": {
    "content": [
      "./dist",
      "./public"
    ]
  },
  "author": "Sofian Medbouhi",
  "license": "UNLICENCED",
  "devDependencies": {
    "@babel/core": "7.6.3",
    "@babel/plugin-proposal-class-properties": "7.4.4",
    "@babel/plugin-proposal-decorators": "7.4.4",
    "@babel/plugin-proposal-export-namespace-from": "7.2.0",
    "@babel/plugin-proposal-function-sent": "7.2.0",
    "@babel/plugin-proposal-json-strings": "7.2.0",
    "@babel/plugin-proposal-numeric-separator": "7.2.0",
    "@babel/plugin-proposal-throw-expressions": "7.2.0",
    "@babel/plugin-syntax-dynamic-import": "7.2.0",
    "@babel/plugin-syntax-import-meta": "7.2.0",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-flow": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.12.7",
    "@bsport/common": "^2.1.1",
    "@types/history": "^4.7.8",
    "@types/react-redux": "^7.1.14",
    "@types/recompose": "^0.30.7",
    "@types/redux-actions": "^2.6.1",
    "@types/seamless-immutable": "^7.1.15",
    "@types/urijs": "^1.19.14",
    "@typescript-eslint/eslint-plugin": "^4.11.1",
    "@typescript-eslint/eslint-plugin-tslint": "^4.11.1",
    "@typescript-eslint/parser": "^4.11.1",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.0.2",
    "babel-jest": "24.8.0",
    "babel-loader": "8.0.6",
    "babel-minify-webpack-plugin": "^0.3.1",
    "babel-preset-airbnb": "4.0.1",
    "babel-preset-env": "^1.7.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react-app": "^9.0.0",
    "clean-webpack-plugin": "3.0.0",
    "copy-webpack-plugin": "5.0.3",
    "css-loader": "3.0.0",
    "cssimportant-loader": "0.4.0",
    "enzyme": "3.10.0",
    "enzyme-adapter-react-16": "1.14.0",
    "enzyme-to-json": "3.3.5",
    "eslint": "^7.16.0",
    "eslint-config-airbnb": "17.1.0",
    "eslint-config-prettier": "^6.0.0",
    "eslint-import-resolver-webpack": "0.11.1",
    "eslint-loader": "2.1.2",
    "eslint-plugin-babel": "^5.3.0",
    "eslint-plugin-cypress": "^2.11.2",
    "eslint-plugin-flowtype": "^3.12.1",
    "eslint-plugin-i18next": "^5.0.0",
    "eslint-plugin-import": "2.18.0",
    "eslint-plugin-jsx-a11y": "6.2.1",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-react": "7.14.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "gh-pages": "2.0.1",
    "husky": "^6.0.0",
    "jest": "24.8.0",
    "jest-cli": "24.8.0",
    "mini-css-extract-plugin": "0.7.0",
    "node-sass": "4.12.0",
    "postcss-increase-specificity": "0.6.0",
    "postcss-loader": "3.0.0",
    "prettier": "^2.2.1",
    "sass-loader": "7.1.0",
    "source-map-explorer": "^2.0.1",
    "style-loader": "0.23.1",
    "terser-webpack-plugin": "^1.4.1",
    "ts-loader": "^8.0.13",
    "tslint": "^6.1.3",
    "typescript": "^4.1.3",
    "url-loader": "2.1.0",
    "webpack": "4.35.0",
    "webpack-bundle-analyzer": "^3.4.1",
    "webpack-cli": "3.3.5",
    "webpack-dev-server": "3.7.2",
    "webpack-obfuscator": "0.18.0",
    "webpack-serve": "3.1.0"
  },
  "dependencies": {
    "@material-ui/core": "^4.9.13",
    "@material-ui/icons": "^4.9.13",
    "@material-ui/styles": "^4.9.13",
    "axios": "^0.19.0",
    "connected-react-router": "^6",
    "history": "^4.9.0",
    "i18next": "^19.8.7",
    "i18next-browser-languagedetector": "^6.0.1",
    "i18next-http-backend": "^1.1.0",
    "prop-types": "^15.6.2",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-i18next": "^11.8.5",
    "react-phone-number-input": "^3.1.10",
    "react-redux": "^7.2.0",
    "react-router": "^5",
    "react-router-dom": "^5",
    "react-transition-group": "^4.0.0",
    "recompose": "^0.30.0",
    "redux": "^4.0.4",
    "redux-actions": "^2.6.5",
    "redux-persist": "^6.0.0",
    "redux-persist-seamless-immutable": "^2.0.0",
    "redux-persist-transform-compress": "^4.2.0",
    "redux-thunk": "^2.3.0",
    "seamless-immutable": "^7.1.4",
    "urijs": "^1.19.6"
  }
}
