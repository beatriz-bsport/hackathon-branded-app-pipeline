{
  "name": "@bsport/template-typescript-package",
  "version": "1.1.0",
  "description": "TypeScript template package",
  "author": "Marwan El Boussarghini <marwan.elboussarghini@thirdbridge.com>",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "build/lib.umd.cjs",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "exports": {
    ".": {
      "import": "./build/lib.es.js",
      "require": "./build/lib.umd.js"
    }
  },
  "files": [
    "build"
  ],
  "dependencies": {},
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  }
}
