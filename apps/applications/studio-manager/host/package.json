{
  "name": "@bsport/sm-host",
  "version": "0.0.1",
  "private": true,
  "description": "Studio Manager - Module Federation host app",
  "author": "Osmel Mora <osmel.mora@bsport.io>",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build --logLevel warn",
    "build:preview": "vite build --mode preview",
    "ci:build:mfe": "./scripts/ci-build.sh",
    "ci:compile": "tsc -b",
    "ci:deploy:mfe": "./scripts/ci-deploy.sh",
    "dev": "nx run @bsport/sm-host:dev:watch --remotes=@bsport/sm-navigation-sidebar",
    "dev:single": "vite",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "preview": "vite preview --mode preview",
    "preview:all": "./scripts/preview-all.sh",
    "translation:update": "pnpm run -w translation:update"
  },
  "dependencies": {
    "@bsport/analytics": "workspace:*",
    "@bsport/broadcast-channel-polyfill": "workspace:*",
    "@bsport/currency": "workspace:*",
    "@bsport/datetime-formatting": "workspace:*",
    "@bsport/envs": "workspace:*",
    "@bsport/fetch": "workspace:*",
    "@bsport/form": "workspace:*",
    "@bsport/i18n": "workspace:*",
    "@bsport/intercom": "workspace:*",
    "@bsport/kaizen-business-components": "workspace:*",
    "@bsport/kaizen-primitive-core": "workspace:*",
    "@bsport/local-storage-auth-token": "workspace:*",
    "@bsport/request-from-header": "workspace:*",
    "@bsport/sentry": "workspace:*",
    "@bsport/sm-aggregators": "workspace:*",
    "@bsport/sm-backbone": "workspace:*",
    "@bsport/sm-contract": "workspace:*",
    "@bsport/sm-custom-form": "workspace:*",
    "@bsport/sm-email-template": "workspace:*",
    "@bsport/sm-giftcard": "workspace:*",
    "@bsport/sm-homepage": "workspace:*",
    "@bsport/sm-insights": "workspace:*",
    "@bsport/sm-invoice": "workspace:*",
    "@bsport/sm-marketing-notification": "workspace:*",
    "@bsport/sm-member-list": "workspace:*",
    "@bsport/sm-order": "workspace:*",
    "@bsport/sm-pack": "workspace:*",
    "@bsport/sm-payout": "workspace:*",
    "@bsport/sm-referral-program": "workspace:*",
    "@bsport/sm-segment": "workspace:*",
    "@bsport/sm-service": "workspace:*",
    "@bsport/sm-session": "workspace:*",
    "@bsport/sm-smartfill": "workspace:*",
    "@bsport/sm-staff": "workspace:*",
    "@bsport/sm-tag": "workspace:*",
    "@bsport/sm-teacher": "workspace:*",
    "@bsport/sm-teacher-view": "workspace:*",
    "@bsport/sm-transactional-notification": "workspace:*",
    "@bsport/sm-venues": "workspace:*",
    "@bsport/sm-vod": "workspace:*",
    "@tanstack/react-query": "^5.90.12",
    "luxon": "^3.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.2.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-federation": "workspace:*",
    "@tanstack/react-query-devtools": "^5.90.12",
    "@types/luxon": "^3.4.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11"
  },
  "federation": {
    "devPort": 4000,
    "remotes": {
      "sm-navigation-sidebar": {
        "devPort": 4050,
        "watchPath": "../navigation-sidebar/src/**/*"
      }
    }
  },
  "nx": {
    "tags": [
      "application:revamp",
      "scope:studio"
    ]
  }
}
