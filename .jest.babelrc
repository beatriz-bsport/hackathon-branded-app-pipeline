{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react",
    "@babel/preset-typescript",
  ],
  "plugins": ["transform-flow-strip-types",
    "@babel/plugin-transform-runtime",
    ["babel-plugin-module-resolver", {
      "alias": {
        "#libs": "./src/libs",
        "#components": "./src/components",
        "#csscomponents":"./src/components/css-only",
        "#hocs": "./src/hocs",
      }
    }]
  ]
}