{
  "name": "@bsport/saas-legacy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "dependsOn": [
        "^build",
        {
          "projects": ["@bsport/sm-navigation-sidebar"],
          "target": "build:compat"
        }
      ]
    },
    "ci:build": {
      "dependsOn": [
        {
          "projects": [
            "@bsport/analytics",
            "@bsport/broadcast-channel-polyfill",
            "@bsport/common",
            "@bsport/consent-management"
          ],
          "target": "build"
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Skipping lint for legacy SaaS'"
      }
    }
  }
}
