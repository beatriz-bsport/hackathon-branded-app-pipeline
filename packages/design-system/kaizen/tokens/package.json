{
  "name": "@bsport/kaizen-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Back-office - Design tokens",
  "author": "Marwan El Boussarghini <marwan@bsport.io>",
  "main": "build/index.js",
  "source": "src/index.ts",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc > /dev/null",
    "ci:merge-request:open": "./scripts/ci-merge-request-open.sh",
    "dev": "tsc -w",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pre-commit": "sh ./scripts/pre-commit.sh",
    "tokens:import": "ts-node -r tsconfig-paths/register ./scripts/import-tokens.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@types/node": "^22.13.15",
    "tsconfig-paths": "^4.2.0"
  },
  "nx": {
    "tags": [
      "postinstall"
    ]
  }
}
