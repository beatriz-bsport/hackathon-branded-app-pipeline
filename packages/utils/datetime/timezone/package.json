{
  "name": "@bsport/timezone-utils",
  "description": "Timezone utilities",
  "version": "0.0.0",
  "author": "Marwan El Boussarghini <marwan@bsport.io>",
  "dependencies": {
    "luxon": "^3.4.4"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*",
    "@types/luxon": "^3.4.2"
  },
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "files": [
    "build"
  ],
  "license": "UNLICENSED",
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  },
  "type": "module",
  "types": "build/lib.d.ts"
}
