{
  "$schema": "https://json-schema.org/schema",
  "id": "MigrateFilenamesToKebabCase",
  "title": "Rename package source files to kebab-case",
  "type": "object",
  "properties": {
    "appName": {
      "type": "string",
      "description": "Package name (e.g., sm-smartlists or @bsport/sm-smartlists)",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What package do you want to migrate?"
    }
  },
  "required": ["appName"]
}
