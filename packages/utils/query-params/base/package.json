{
  "name": "@bsport/base-query-params",
  "description": "Set of utils to implement hooks for state in URL",
  "version": "0.0.0",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "files": [
    "build"
  ],
  "license": "UNLICENSED",
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  },
  "type": "module",
  "types": "build/lib.d.ts"
}
