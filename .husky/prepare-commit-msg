COMMIT_MSG_FILE=$1

if [ "$SKIP_CZ" = "1" ]; then
	exit 0
fi

COMMIT_MSG=`cat $COMMIT_MSG_FILE`

echo $COMMIT_MSG | pgrep '[a-z]\(.+\): .+' && MATCHING=1 || MATCHING=0;

(test -d ".git/CHERRY_PICK_HEAD" || test -d ".git/rebase-merge" || test -d ".git/rebase-apply") && IS_REBASE=1 || IS_REBASE=0

if [ $MATCHING = 1 ]
then
	exit 0
else
	if [ $IS_REBASE = 1 ]
	then
		exit 0
	else
		if [ "$ECOSYSTEM_SKIP_HOOKS" = "true" ]
		then
			exit 0
		else
			exec < /dev/tty && git cz --hook || true
		fi
	fi
fi

exit 0
