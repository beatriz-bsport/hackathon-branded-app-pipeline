{
  "name": "@bsport/saas-legacy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "NODE_ENV=production ANALYZE=true webpack build --config config/webpack.prod.js",
    "build": "export CI=false ; node --max_old_space_size=19000 scripts/build.js",
    "ci:build": "./scripts/ci-build.sh > /dev/null",
    "ci:compile": "tsc --strict false -p ./tsconfig.json",
    "ci:deploy": "./scripts/ci-deploy.sh > /dev/null",
    "compile": "npx tsc -p .",
    "debug-only:start-production": "concurrently --kill-others \"pnpm run start:sidebar\" \"pnpm run debug-only:start:production\"",
    "debug-only:start:production": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && pnpm run translation:update && cp envs/production-api-only public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "format": "find src -name \"*.js\" | xargs pnpm exec prettier --write",
    "generate-all-css-marketplace": "cat  **/Marketplace*.css > ./Marketplace.css",
    "knip": "NODE_ENV=development knip",
    "lint-old": "eslint ./src --max-warnings 250",
    "lint-old:cache": "eslint ./src --cache",
    "lint-old:fix": "eslint ./src --fix",
    "pretty": "export NODE_OPTIONS=--openssl-legacy-provider && pnpm exec prettier './src' --check",
    "pretty-cache": "export NODE_OPTIONS=--openssl-legacy-provider && pnpm exec prettier './src' --check --cache",
    "pretty-fix": "export NODE_OPTIONS=--openssl-legacy-provider && pnpm exec prettier './src' --write",
    "pretty-fix-cache": "export NODE_OPTIONS=--openssl-legacy-provider && pnpm exec prettier './src' --write --cache",
    "refresh-timezone-by-country": "ts-node src/utils/timezone-country/scripts/refresh-timezone-db.ts",
    "server:build": "webpack -p --progress",
    "start": "concurrently --kill-others \"pnpm run start:sidebar\" \"pnpm run start:main\"",
    "start-dev": "concurrently --kill-others \"pnpm run start:sidebar\" \"pnpm run start:dev\"",
    "start-production": "concurrently --kill-others \"pnpm run start:sidebar\" \"pnpm run start:production\"",
    "start-staging": "concurrently --kill-others \"pnpm run start:sidebar\" \"pnpm run start:staging\"",
    "start:dev": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && pnpm run translation:update && cp envs/dev-api-only public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "start:main": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && pnpm run translation:update && cp envs/local public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "start:production": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && pnpm run translation:update && cp envs/production-api-only public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "start:sidebar": "pnpm --filter=@bsport/sm-navigation-sidebar preview:compat",
    "start:staging": "export NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development && pnpm run translation:update && cp envs/staging-api-only public/env.js && BROWSER=none webpack serve --config config/webpack.dev.js",
    "test": "export NODE_OPTIONS=--openssl-legacy-provider && pnpm exec jest --logHeapUsage",
    "translation:update": "pnpm run -w translation:update"
  },
  "browserslist": "> 0.25%",
