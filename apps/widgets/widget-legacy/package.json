{
  "name": "@bsport/widget-legacy",
  "version": "0.1.0",
  "private": true,
  "description": "Bsport widget",
  "license": "UNLICENCED",
  "author": "Sofian Medbouhi",
  "main": "index.js",
  "scripts": {
    "analyze": "source-map-explorer dist/widget.js",
    "build": "NODE_ENV=production NODE_OPTIONS=--max_old_space_size=8192 webpack-cli --mode production",
    "bundle:analyze": "NODE_ENV=production ANALYZE=true webpack build --config webpack.config.js",
    "ci:build": "./scripts/ci-build.sh > /dev/null",
    "ci:deploy": "./scripts/ci-deploy.sh > /dev/null",
    "deploy": "npm run build && gh-pages -d dist",
    "lint-broken": "eslint ./src",
    "start": "NODE_ENV=development NODE_OPTIONS=--openssl-legacy-provider webpack serve --config webpack.config.js",
    "start:dev": "DEST_CONFIG=dev pnpm run start",
    "start:local": "DEST_CONFIG=local pnpm run start",
    "start:mix": "DEST_CONFIG=local-fe-dev-be pnpm run start",
    "start:production": "DEST_CONFIG=production pnpm run start",
    "start:staging": "DEST_CONFIG=staging pnpm run start",
    "test": "jest",
    "test-update-snapshots": "jest --updateSnapshot"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-syntax-dynamic-import",
      "@babel/plugin-syntax-import-meta",
      "@babel/plugin-transform-class-properties",
      "@babel/plugin-proposal-function-sent",
      "@babel/plugin-transform-export-namespace-from",
      "@babel/plugin-transform-numeric-separator",
      "@babel/plugin-proposal-throw-expressions",
      "@babel/plugin-proposal-optional-chaining",
      "@babel/plugin-proposal-nullish-coalescing-operator"
    ],
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript",
      "@babel/preset-flow"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.js?(x)"
    ],
    "coverageDirectory": "./coverage/",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test-helpers/"
    ],
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "transform": {
      "^.+\\.(js|jsx|mjs)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.(css|scss)$": "<rootDir>/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|css|json)$)": "<rootDir>/jest/fileTransform.js"
    }
  },
  "dependencies": {
    "@bsport/saas-legacy": "workspace:*",
    "@material-ui/core": "^4.9.13",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/styles": "^4.9.13",
    "axios": "^0.19.0",
    "connected-react-router": "^6",
    "history": "^4.9.0",
    "i18next": "^19.8.7",
    "i18next-browser-languagedetector": "^6.0.1",
    "i18next-http-backend": "^1.1.0",
    "prop-types": "^15.6.2",
    "react": "16.10.2",
    "react-dom": "16.10.2",
    "react-i18next": "^11.8.5",
    "react-phone-number-input": "^3.1.10",
    "react-redux": "^7.2.0",
    "react-router": "^5",
    "react-router-dom": "^5",
    "react-transition-group": "^4.0.0",
    "recompose": "^0.30.0",
    "redux": "^4.0.4",
    "redux-actions": "^2.6.5",
    "redux-persist": "^6.0.0",
    "redux-persist-seamless-immutable": "^2.0.0",
    "redux-persist-transform-compress": "^4.2.0",
    "redux-thunk": "^2.3.0",
    "sass": "^1.77.4",
    "sass-loader": "^14.2.1",
    "seamless-immutable": "^7.1.4",
    "urijs": "^1.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.6.2",
    "@babel/plugin-proposal-function-sent": "^7.24.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-throw-expressions": "^7.24.7",
    "@babel/plugin-syntax-import-meta": "7.2.0",
    "@babel/plugin-syntax-typescript": "^7.24.7",
    "@babel/plugin-transform-class-properties": "^7.24.7",
    "@babel/plugin-transform-export-namespace-from": "^7.24.7",
    "@babel/plugin-transform-numeric-separator": "^7.24.0",
    "@babel/plugin-transform-optional-chaining": "^7.24.7",
    "@babel/plugin-transform-typescript": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-flow": "^7.24.7",
    "@babel/preset-react": "^7.24.6",
    "@babel/preset-typescript": "^7.24.7",
    "@bsport/common": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@types/history": "^4.7.8",
    "@types/react-dom": "^17.0.0",
    "@types/react-redux": "^7.1.14",
    "@types/recompose": "^0.30.7",
    "@types/redux-actions": "^2.6.1",
    "@types/seamless-immutable": "^7.1.15",
    "@types/urijs": "^1.19.14",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/eslint-plugin-tslint": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "babel-minify-webpack-plugin": "^0.3.1",
    "classnames": "^2.5.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "cssimportant-loader": "0.4.0",
    "enzyme": "3.10.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^9.4.0",
    "eslint-config-airbnb": "17.1.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-webpack": "0.11.1",
    "eslint-plugin-babel": "^5.3.0",
    "eslint-plugin-bsport": "^1.0.3",
    "eslint-plugin-cypress": "^2.11.2",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-i18next": "^6.0.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-react": "7.14.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "file-loader": "6.2.0",
    "gh-pages": "2.0.1",
    "husky": "^6.0.0",
    "javascript-obfuscator": "^4.1.0",
    "jest": "24.8.0",
    "jest-cli": "24.8.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss-increase-specificity": "0.6.0",
    "postcss-loader": "2.0.8",
    "prettier": "^2.2.1",
    "source-map-explorer": "^2.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "tslint": "^6.1.3",
    "typescript": "^5.4.5",
    "url-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-obfuscator": "^3.5.1"
  },
  "engines": {
    "node": ">=22"
  },
  "serve": {
    "content": [
      "./dist",
      "./public"
    ]
  }
}
