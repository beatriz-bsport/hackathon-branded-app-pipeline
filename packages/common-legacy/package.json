{
  "name": "@bsport/common",
  "version": "4.0.20",
  "description": "Commons utilities and values for bsport",
  "license": "UNLICENSED",
  "author": "Sofian Medbouhi <sofian@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./*",
      "require": "./*",
      "default": "./*"
    }
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "check-type": "tsc --noEmit",
    "ci:compile": "tsc --noEmit",
    "compile": "tsc && tsc-alias",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "luxon": "^3.4.4",
    "memoize-one": "^4.0.2",
    "tslint": "^6.1.3",
    "typescript": "^4.1.3"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*",
    "@types/luxon": "^3.4.2",
    "@types/memoize-one": "^4.1.1",
    "@types/node": "^14.14.21",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.8.10"
  },
  "nx": {
    "tags": [
      "postinstall",
      "execute:unit-tests"
    ]
  }
}
