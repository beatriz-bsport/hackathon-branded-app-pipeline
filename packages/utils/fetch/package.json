{
  "name": "@bsport/fetch",
  "version": "0.0.0",
  "description": "bsport API fetch",
  "author": "Marwan El Boussarghini <marwan@bsport.io>",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "build/lib.umd.cjs",
  "module": "build/lib.js",
  "types": "build/lib.d.ts",
  "exports": {
    ".": {
      "import": "./build/lib.js",
      "require": "./build/lib.umd.cjs"
    }
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@bsport/random-utils": "workspace:*",
    "@bsport/timezone-utils": "workspace:*",
    "@sentry/react": "^7.26.0"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  }
}
