{
  "name": "@bsport/i18n",
  "version": "0.0.0",
  "description": "Package to easily setup i18n in a project",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "main": "build/lib.umd.cjs",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "require": "./build/lib.umd.js",
      "default": "./build/lib.es.js"
    }
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "i18next": "^24.2.1",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^3.0.1",
    "luxon": "^3.4.4",
    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*",
    "@types/luxon": "^3.4.2"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  }
}
