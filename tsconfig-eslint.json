{
  "compilerOptions": {
    "skipDefaultLibCheck": true,
    "allowJs": false,
    "outDir": "build",
    "sourceRoot": "src",
    "noEmit": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "lib": [
      "es2015",
      "es2016",
      "es2018",
      "es2017",
      "dom",
      "es2019",
      "es2020",
      "ESNext"
    ],
    "moduleResolution": "node",
    "types": ["react", "node", "jest", "@testing-library/jest-dom"],
    "baseUrl": ".", // This must be specified if paths is.
    "paths": {
      "#src/*": ["./src/*"],
      "#libs/*": ["./src/libs/*"],
      "#components/*": ["./src/components/*"],
      "#hocs/*": ["./src/hocs/*"],
      "#csscomponents/*": ["./src/components/css-only/*"],
      "#Fabrique/*": ["./src/components/css-only/Fabrique/*"],
      "#untitledui/*": ["./src/components/untitledui/*"],
      "#pages/*": ["./src/pages/*"],
      "#state": ["./src/state/*"]
    }
  },
  "include": ["./src/**/*.ts*"]
}
