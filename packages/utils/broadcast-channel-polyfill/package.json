{
  "name": "@bsport/broadcast-channel-polyfill",
  "version": "1.0.0",
  "private": false,
  "description": "BroadcastChannel polyfill",
  "license": "UNLICENSED",
  "author": "Osmel Mora <osmel.mora@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "files": [
    "build",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build",
    "ci:compile": "tsc",
    "ci:publish": "./scripts/ci-publish.sh",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "upgrade-version": "npm version"
  },
  "dependencies": {},
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*"
  },
  "nx": {
    "tags": [
      "postinstall"
    ]
  }
}
