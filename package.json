{
  "name": "@bsport/ichizen",
  "version": "1.0.0",
  "description": "Source code of all bsport's web interfaces, including the interface for our clients, their members and the widget that our client integrate of their own websites.",
  "keywords": [
    "monorepository",
    "nx",
    "react",
    "storybook",
    "tailwindcss",
    "vite"
  ],
  "license": "UNLICENSED",
  "author": "bsport<tech@bsport.io>",
  "scripts": {
    "api-environment:set": "ts-node tools/toolkit-cli/src/index.ts api-environment:set",
    "build": "nx build",
    "build:all": "nx run-many --all --target=build",
    "cleanup": "bash tools/scripts/cleanup-and-rebuild.sh",
    "docs:events": "pnpm exec nx docs:generate @bsport/analytics",
    "feature-flags-environment:set": "ts-node tools/toolkit-cli/src/index.ts feature-flags-environment:set",
    "federate:navigation": "pnpm --filter '@bsport/sm-navigation-sidebar' dev",
    "format": "pnpm exec nx run-many -t format",
    "format:affected": "pnpm exec nx affected --target=format",
    "format:check": "pnpm exec nx run-many -t format:check",
    "format:check:affected": "pnpm exec nx affected --target=format:check",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm exec nx run-many --target=build --projects=tag:postinstall",
    "lint": "pnpm exec nx run-many -t lint",
    "lint:affected": "pnpm exec nx affected --target=lint",
    "lint:affected:fix": "pnpm exec nx affected --target=lint:fix",
    "lint:fix": "pnpm exec nx run-many -t lint:fix",
    "prepare": "husky",
    "project:create": "ts-node tools/toolkit-cli/src/index.ts project:create",
    "project:dependencies:list": "ts-node tools/toolkit-cli/src/index.ts project:dependencies:list",
    "project:import": "ts-node tools/toolkit-cli/src/index.ts project:import",
    "project:list": "ts-node tools/toolkit-cli/src/index.ts project:list",
    "pwd": "pwd",
    "sync:list": "pnpm exec syncpack list",
    "sync:mismatch:fix": "pnpm exec syncpack fix-mismatches",
    "sync:mismatch:list": "pnpm exec syncpack list-mismatches",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "translation:fillup": "pnpm --filter=@bsport/i18n-management project:translate-missing-strings",
    "translation:keys": "pnpm --filter=@bsport/i18n-management project:find-unused-keys",
    "translation:migrate": "pnpm exec nx translation:migrate @bsport/i18n-management",
    "translation:project:transform": "pnpm --filter=@bsport/i18n-management project:transform",
    "translation:update": "pnpm --silent --filter=@bsport/i18n-management translation:update",
    "utils": "ts-node tools/toolkit-cli/src/index.ts"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.2",
    "@module-federation/vite": "^1.2.6",
    "@nx/devkit": "20.3.0",
    "@nx/eslint": "20.3.0",
    "@nx/eslint-plugin": "20.3.0",
    "@nx/js": "20.3.0",
    "@nx/react": "20.3.0",
    "@nx/storybook": "20.3.0",
    "@nx/vite": "20.3.0",
    "@nx/web": "20.3.0",
    "@nx/workspace": "20.3.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-themes": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/core-server": "8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/react-webpack5": "8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "0.19.1",
    "@storybook/theming": "^8.6.14",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.9.2",
    "@swc/helpers": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.13.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "commitizen": "^4.3.1",
    "concurrently": "^8.2.2",
    "core-js": "^3.39.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.6",
    "hygen": "^6.2.11",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.4.3",
    "msw": "^2.7.6",
    "nx": "20.3.0",
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^2.5.10",
    "sort-package-json": "^2.14.0",
    "storybook": "^8.6.14",
    "storybook:configuration.@latest": "link:@nx/storybook:configuration.@latest",
    "syncpack": "^13.0.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "type-fest": "^4.26.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-restart": "^0.4.2",
    "vite-plugin-svgr": "^4.3.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "pnpm": "10.11.0"
  },
  "pnpm": {
    "overrides": {
      "unlayer-types": "1.278.0"
    }
  }
}
