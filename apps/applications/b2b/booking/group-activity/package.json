{
  "name": "@bsport/sm-group-activity",
  "version": "0.0.0",
  "private": true,
  "description": "Group activity",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "federation:navigation": "pnpm exec nx build @bsport/sm-navigation-sidebar && pnpm exec nx preview @bsport/sm-navigation-sidebar",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "preview": "vite preview",
    "translation:update": "pnpm run -w translation:update"
  },
  "dependencies": {
    "@bsport/b2b-backbone": "workspace:*",
    "@bsport/fetch": "workspace:*",
    "@bsport/i18n": "workspace:*",
    "@bsport/kaizen-primitive-core": "workspace:*",
    "@bsport/store-booking-group-activity": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0",
    "typescript-result": "^3.1.1"
  },
  "devDependencies": {
    "@bsport/config-federation": "workspace:*",
    "@bsport/eslint-config-react": "workspace:*",
    "@originjs/vite-plugin-federation": "^1.3.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^4.3.0"
  },
  "author": "Blaise <blaise@bsport.io>"
}
