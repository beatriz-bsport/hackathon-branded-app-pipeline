{
  "name": "@bsport/nx",
  "version": "1.0.0",
  "private": true,
  "description": "Nx plugin with generators and executors for Studio Manager workflows",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@bsport/config-federation": "workspace:*",
    "@nx/devkit": "21.6.10",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "//": "Source-only package: Nx consumes TypeScript directly via ts-node. No build step required.",
  "executors": "./executors.json",
  "generators": "./generators.json",
  "nx": {
    "targets": {
      "release-tag": {
        "executor": "@bsport/nx:release-tag",
        "cache": false,
        "parallelism": false
      }
    },
    "tags": [
      "postinstall"
    ]
  }
}
