{
  "name": "@bsport/sentry",
  "version": "0.1.0",
  "description": "Library to init and configure Sentry",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "private": true,
  "type": "module",
  "main": "build/lib.umd.js",
  "module": "build/lib.es.js",
  "types": "build/lib.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.es.js",
      "require": "./build/lib.umd.cjs",
      "default": "./build/lib.es.js"
    }
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@bsport/random-utils": "workspace:*",
    "@sentry/react": "^7.26.0"
  },
  "devDependencies": {
    "@bsport/eslint-config-react": "workspace:*"
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "pnpm run build"
  }
}
