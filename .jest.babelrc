{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react",
    "@babel/preset-typescript",
  ],
  "plugins": [
    "transform-flow-strip-types",
    "@babel/plugin-transform-runtime",
    [
      "babel-plugin-module-resolver",
      {
        "alias": {
          "#libs": "./src/libs",
          "#marketplacecomponents": "./src/libs/marketplace/components",
          "#components": "./src/components",
          "#csscomponents": "./src/components/css-only",
          "#hocs": "./src/hocs",
          "#hooks": "./src/hooks",
          "#utils": "./src/utils",
          "#Fabrique": "./src/components/css-only/Fabrique",
          "#untitledui": "./src/components/untitledui"
        }
      }
    ]
  ]
}