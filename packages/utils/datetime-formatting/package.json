{
  "name": "@bsport/datetime-formatting",
  "version": "0.0.0",
  "private": true,
  "description": "Datetime Formatting",
  "license": "UNLICENSED",
  "author": "Théo Steffanetti <theo.steffanetti@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build --logLevel warn",
    "ci:compile": "tsc -p tsconfig.json --noEmit",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*",
    "@types/luxon": "^3.4.2",
    "luxon": "^3.4.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "luxon": "^3.4.4"
  },
  "nx": {
    "tags": [
      "execute:unit-tests",
      "postinstall"
    ]
  }
}
