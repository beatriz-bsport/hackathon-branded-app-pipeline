{
  "name": "@bsport/store-cdp-smartlist",
  "version": "0.0.0",
  "private": true,
  "description": "Smartlist store",
  "license": "UNLICENSED",
  "author": "Osmel Mora <osmel.mora@bsport.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/lib.es.js",
      "default": "./build/lib.es.js"
    }
  },
  "main": "build/lib.es.js",
  "module": "build/lib.es.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build --logLevel warn",
    "ci:compile": "tsc",
    "dev": "vite build --watch",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bsport/store-base": "workspace:*",
    "typescript-result": "^3.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-vitest": "workspace:*",
    "@bsport/fetch": "workspace:*"
  },
  "nx": {
    "tags": [
      "execute:unit-tests",
      "postinstall"
    ]
  }
}
