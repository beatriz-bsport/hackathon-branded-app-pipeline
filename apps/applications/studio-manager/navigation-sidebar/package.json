{
  "name": "@bsport/sm-navigation-sidebar",
  "version": "0.0.0",
  "private": true,
  "description": "Navigation sidebar",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "type": "module",
  "exports": {
    "./styles": "./dist/assets/style.css"
  },
  "scripts": {
    "build": "tsc && vite build --logLevel warn",
    "build:compat": "vite build --mode compat",
    "build:preview": "vite build --mode preview",
    "ci:compile": "tsc --noEmit",
    "dev": "vite",
    "dev:single": "pnpm dev",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "lint": "eslint .",
    "preview": "vite preview --mode preview",
    "preview:compat": "pnpm run build:compat && vite preview --mode compat",
    "translation:update": "pnpm run -w translation:update"
  },
  "dependencies": {
    "@bsport/currency": "workspace:*",
    "@bsport/datetime-manipulation": "workspace:*",
    "@bsport/envs": "workspace:*",
    "@bsport/fetch": "workspace:*",
    "@bsport/i18n": "workspace:*",
    "@bsport/kaizen-primitive-core": "workspace:*",
    "@bsport/permissions": "workspace:*",
    "@bsport/sm-backbone": "workspace:*",
    "@bsport/store-auth": "workspace:*",
    "@bsport/store-cdp-tag": "workspace:*",
    "@bsport/store-core-data-member": "workspace:*",
    "@bsport/store-staff-management-alerting": "workspace:*",
    "@bsport/store-staff-management-attendance": "workspace:*",
    "@bsport/use-async": "workspace:*",
    "@bsport/use-debounce": "workspace:*",
    "@module-federation/bridge-react": "^0.13.1",
    "luxon": "^3.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.2.0"
  },
  "devDependencies": {
    "@bsport/config-eslint-react": "workspace:*",
    "@bsport/config-federation": "workspace:*",
    "@types/luxon": "^3.4.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11"
  },
  "federation": {
    "devPort": 4050,
    "exposes": {
      "./NavigationSidebar": "./src/components/NavigationSidebar",
      "./urls": "./src/urls",
      "./BridgedSidebar": "./src/components/BridgedSidebar"
    }
  },
  "nx": {
    "tags": [
      "application:revamp",
      "scope:studio"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "translation:update"
        ]
      }
    }
  }
}
