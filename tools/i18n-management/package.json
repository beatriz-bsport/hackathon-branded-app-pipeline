{
  "name": "@bsport/i18n-management",
  "version": "1.0.0",
  "description": "Library to manage build translations and Weblate interaction",
  "author": "David Bretaud <david.bretaud@bsport.io>",
  "scripts": {
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,cjs,mjs,scss,css,json,md,mdx,html,svg}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,cjs,mjs}'",
    "project:transform": "tsx ./scripts/transform-project-structure.ts",
    "translation:migrate": "tsx ./scripts/import-legacy-translations.ts",
    "translation:update": "tsx ./scripts/build-public-locales-files.ts"
  },
  "dependencies": {
    "@bsport/typescript-monorepo-utils": "workspace:*",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.3.3",
    "@types/fs-extra": "^11.0.1",
    "commander": "^9.3.0",
    "inquirer-select-pro": "1.0.0-alpha.9",
    "json-beautify": "^1.1.1",
    "json-merger": "^2.0.0",
    "tsx": "^4.19.2"
  }
}
